# ---------------------------------------------------------------------------
# Frontend environment (Vite)
#
# WARNING: every VITE_* value here is compiled into the JavaScript bundle and
# is therefore PUBLIC. Anyone can read them in devtools. Never put a secret,
# private key, service-account JSON, or database credential in this file.
# Secrets belong in Backend/.env only.
#
# Restrict the browser keys below at the provider instead:
#   - Google Maps: HTTP referrer restrictions + enable only the APIs you use
#   - Firebase Web API key: it is designed to be public; lock down Firebase
#     Security Rules and App Check rather than hiding the key
# ---------------------------------------------------------------------------

# --- Backend wiring --------------------------------------------------------
# Backend/.env has PORT=5000, and the backend mounts routes at both /api and
# /api/v1. If VITE_API_BASE_URL is unset the app defaults to
# http://localhost:5000/api/v1 (see src/shared/api/runtimeConfig.js).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Origin used for sockets and asset URLs. Falls back to API_BASE_URL minus the
# /api/v1 suffix when unset, so you normally only need this if the socket or
# asset host differs from the API host.
VITE_BACKEND_ORIGIN=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_ASSET_BASE_URL=http://localhost:5000

# --- Google Maps -----------------------------------------------------------
# Required for: location picker, live tracking, route/fare distance, zone
# polygons. Leave blank and the app degrades to a haversine fallback with no
# map (HAS_VALID_GOOGLE_MAPS_KEY in src/modules/admin/utils/googleMaps.js).
# Needs: Maps JavaScript API, Places API, Routes API, Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase (web push / FCM + realtime mirror) ---------------------------
# From Firebase console > Project settings > General > Your apps > Web app.
# The backend uses a SERVICE ACCOUNT (Backend/.env) — do not put that here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL — mirror Backend/.env FIREBASE_DATABASE_URL so the
# ride-state mirror reads and writes the same place.
VITE_FIREBASE_DATABASE_URL=

# Web Push certificate key pair: Firebase console > Project settings >
# Cloud Messaging > Web Push certificates. Without it browser push silently
# never registers a token.
VITE_FIREBASE_VAPID_KEY=
